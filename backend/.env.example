FRONTEND_ORIGIN=http://localhost
PORT=3001
TZ=Europe/Warsaw
JWT_SECRET=change-me-to-a-long-random-secret

# Windows host PulseAudio (see docs/DOCKER_AUDIO_SETUP.md)
PULSE_SERVER=tcp:host.docker.internal:4713
SDL_AUDIODRIVER=pulse

FFPLAY_PATH=/usr/bin/ffplay
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_LOCATION=/usr/bin

DATA_DIR=/app/data
SONGS_DIR=/app/data/songs
QUEUE_FILE_PATH=/app/data/queue.json
DB_PATH=/app/data/app.db

QUEUE_RANDOM_MIN_REMAINING=10
QUEUE_RANDOM_FILL_SIZE=10

# Optional. Overrides config.json voteTieBreakMode when set.
# oldest_vote | older_latest_vote | newest_vote
# VOTE_TIE_BREAK_MODE=oldest_vote

DOWNLOAD_MAX_CONCURRENCY=2
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RETRY_DELAY_MS=2000
